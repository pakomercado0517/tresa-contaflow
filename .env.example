# Servidor
NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

# Base de datos (PostgreSQL)
DATABASE_URL=postgresql://usuario:password@host:5432/railway

# JWT
JWT_SECRET=tu-secret-key-muy-segura
JWT_REFRESH_SECRET=tu-refresh-secret-key-muy-segura

# Frontend / CORS / links de email y reportes
FRONTEND_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Rate limiting (opcional)
API_RATE_LIMIT_MAX=2000

# Email (Brevo)
BREVO_API_KEY=tu-api-key-brevo
BREVO_FROM_EMAIL=noreply@tudominio.com
BREVO_FROM_NAME=Tresa Contafy

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PRICE_ID_BASIC=price_...
STRIPE_PRICE_ID_BASIC_ANNUAL=price_...
STRIPE_PRICE_ID_PRO=price_...
STRIPE_PRICE_ID_PRO_ANNUAL=price_...
STRIPE_PRICE_ID_ENTERPRISE=price_...
STRIPE_PRICE_ID_ENTERPRISE_ANNUAL=price_...

# Admin (emails separados por coma)
ADMIN_EMAILS=admin@tudominio.com

# Firebase (Google login)
FIREBASE_PROJECT_ID=tu-proyecto
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@tu-proyecto.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# SAT / FIEL (cifrado de certificados)
SAT_FIEL_ENCRYPTION_KEY=clave-de-32-bytes-en-base64-o-hex

# Cron interno (header X-Cron-Secret)
CRON_SECRET=tu-cron-secret

# Captcha externo (opcional)
CAPTCHA_API_KEY=
CAPTCHA_SERVICE_URL=https://2captcha.com/in.php
CAPTCHA_RESULT_URL=https://2captcha.com/res.php

# ---------------------------------------------------------------------------
# Redis (Railway Redis)
# ---------------------------------------------------------------------------
# Obligatoria: URL completa que Railway inyecta en el servicio Redis.
# Ejemplo Railway: redis://default:PASSWORD@HOST:PORT
# También usada para deny-list de access/refresh en logout (TTL = exp del JWT).
REDIS_URL=redis://default:PASSWORD@HOST:PORT

# Opcionales: TTL en segundos (red de seguridad si una invalidación falla)
# Métricas y tax-estimates (dashboard autenticado)
CACHE_TTL_METRICS_SECONDS=300
CACHE_TTL_TAX_ESTIMATES_SECONDS=300
# Reportes públicos (mismo default; la invalidación al escribir los actualiza al momento)
CACHE_TTL_PUBLIC_REPORTS_SECONDS=300
# Listados de facturas y gastos
CACHE_TTL_INVOICES_LIST_SECONDS=300
CACHE_TTL_EXPENSES_LIST_SECONDS=300
# GET /api/auth/me
CACHE_TTL_AUTH_ME_SECONDS=300
